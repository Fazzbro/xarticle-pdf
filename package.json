{
  "name": "xarticle-pdf",
  "version": "1.0.0",
  "description": "Production-grade tool to export X (Twitter) Articles as cleanly structured, editorial-quality PDFs from pasted links.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xarticle-pdf": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli.ts",
    "build": "tsc && npx vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "playwright-core": "^1.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.3.8",
    "vitest": "^3.1.1"
  }
}
